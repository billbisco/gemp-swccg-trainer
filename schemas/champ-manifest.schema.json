{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gempukku.github.io/schemas/champ-manifest.schema.json",
  "title": "SWCCG Champ Pack Manifest",
  "type": "object",
  "required": ["manifestVersion", "id", "displayName", "policyKind", "gymApiVersion", "createdAt", "files", "hash"],
  "properties": {
    "manifestVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "policyKind": { "type": "string", "enum": ["heuristic.v1", "linear.v1"] },
    "gymApiVersion": { "type": "string" },
    "createdAt": { "type": "string" },
    "parentId": { "type": ["string", "null"] },
    "elo": { "type": ["number", "null"] },
    "ladderId": { "type": ["string", "null"] },
    "deckHints": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "object",
      "required": ["weights"],
      "properties": { "weights": { "type": "string" } }
    },
    "hash": {
      "type": "object",
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "signature": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
